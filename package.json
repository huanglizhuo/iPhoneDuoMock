{
  "name": "duo-studio",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "npm run build && node tests/production-smoke.mjs",
    "format:check": "prettier --check src tests *.ts *.json",
    "test:webkit": "playwright test --config=playwright.webkit.config.ts",
    "prebuild": "node scripts/generate-seo.mjs",
    "capture:guide": "node scripts/capture-guide-assets.mjs",
    "test:seo": "node tests/seo.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
